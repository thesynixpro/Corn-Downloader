# Universal Video Downloader Bot — copy to ".env" locally or set these as
# environment variables / Railway service variables. Never commit real secrets.

# Required — bot token from @BotFather on Telegram.
BOT_TOKEN=

# Optional — max accepted video size in MB (1-2000). Default 700.
# NOTE: the default cloud Bot API rejects bot uploads above ~50 MB.
# For >50 MB uploads set TELEGRAM_API_URL (self-hosted Bot API server) or
# API_ID/API_HASH (MTProto direct upload). Otherwise files above ~50 MB are
# split into SPLIT_PART_MB parts when possible.
MAX_FILE_MB=700

# Optional — base temp download directory. Default /tmp/video_downloads.
DOWNLOAD_DIR=/tmp/video_downloads

# Optional — global simultaneous download cap (1-16). Default 3.
MAX_CONCURRENT_DOWNLOADS=3

# Optional — per-request network/extractor timeout in seconds. Default 120.
REQUEST_TIMEOUT=120

# Optional — TCP connect timeout in seconds. Default 30.
CONNECT_TIMEOUT=30

# Optional — overall per-download watchdog in seconds (0 disables). Default 3600.
DOWNLOAD_TIMEOUT=3600

# Optional — self-hosted/local Bot API server base URL (no trailing "/bot").
# Example: TELEGRAM_API_URL=http://localhost:8081
# Leave empty to use Telegram's default cloud API (max ~50 MB uploads).
TELEGRAM_API_URL=

# Optional — split delivery for the cloud Bot API (~50 MB/bot-upload cap).
# Videos within MAX_FILE_MB but above ~50 MB are cut into parts and sent as
# multiple messages. Only used when TELEGRAM_API_URL is NOT set.
SPLIT_PART_MB=45
SPLIT_MAX_PARTS=15

# Optional — MTProto direct upload (single files up to ~2 GB) logged in as the
# BOT itself (same BOT_TOKEN, no user session). Needs API_ID + API_HASH from
# https://my.telegram.org. When set, large files upload directly as ONE video
# instead of being split into parts. Leave empty to use split delivery.
API_ID=
API_HASH=

# Optional — maximum HLS/yt-dlp video height to select (0 = no cap). Default 2160.
MAX_VIDEO_HEIGHT=2160

# Optional — restrict accepted URLs to these hosts and their subdomains
# (comma-separated). Empty = any public host. SSRF checks always apply.
ALLOWED_HOSTS=

# Optional — temporary disk budget in MB for all downloads. Default 5000.
MAX_TEMP_DISK_MB=5000

# Optional — parallel HLS segment downloads (1-16). Default 4.
HLS_SEGMENT_CONCURRENCY=4

# Optional — extra Referer header for direct .m3u8 / direct media links whose
# CDN requires one. Leave empty unless needed.
HLS_REFERER=

# Optional — User-Agent used by the native HLS/direct-download engines.
HLS_USER_AGENT=

# Optional — log verbosity: DEBUG / INFO / WARNING / ERROR. Default INFO.
LOG_LEVEL=INFO

# --- The two below belong to the SEPARATE Bot API server service, NOT this bot. ---
# If you run telegram-bot-api as a second Railway service, set THESE THERE:
# TELEGRAM_API_ID=12345678        (from https://my.telegram.org -> API development tools)
# TELEGRAM_API_HASH=abcdef...     (from https://my.telegram.org -> API development tools)
